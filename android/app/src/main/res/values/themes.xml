<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CritterExtraction" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/critter_background</item>
        <item name="android:colorAccent">#7EF7D4</item>
        <item name="android:statusBarColor">@color/critter_navigation</item>
        <item name="android:navigationBarColor">@color/critter_navigation</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/critter_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">350</item>
    </style>
</resources>
